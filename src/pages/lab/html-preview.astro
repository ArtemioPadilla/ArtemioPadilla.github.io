---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import Navigation from "../../components/layout/Navigation.astro";
import Footer from "../../components/layout/Footer.astro";
import LabToolLayout from "../../components/lab/LabToolLayout.astro";
import HtmlPreview from "../../components/lab/html-preview/HtmlPreview.tsx";
---

<BaseLayout
  title="HTML Preview — Lab — Artemio Padilla"
  description="Live HTML editor with sandboxed iframe preview. Paste or load an HTML file and see it rendered instantly."
>
  <Navigation currentPath="/lab" />
  <LabToolLayout currentSlug="html-preview">
  <main class="px-6 pt-32 pb-24 md:pt-40 md:pb-32">
    <div class="mx-auto max-w-6xl">
      <!-- Breadcrumb -->
      <div class="mb-6 flex items-center gap-2 text-xs text-[var(--color-text-muted)]">
        <a href="/lab" class="no-underline transition-colors hover:text-[var(--color-heading)]">Lab</a>
        <span>/</span>
        <span class="text-[var(--color-heading)]">HTML Preview</span>
      </div>

      <!-- Header -->
      <div class="mb-8">
        <div class="flex items-center gap-3">
          <span class="text-3xl">🌐</span>
          <h1 class="font-heading text-3xl font-bold uppercase text-[var(--color-heading)] sm:text-4xl">
            HTML Preview
          </h1>
        </div>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--color-text-muted)] sm:text-base">
          Paste HTML or load a file. See it rendered live in a sandboxed iframe. Supports inline CSS and JavaScript.
        </p>
      </div>

      <!-- Tool -->
      <HtmlPreview client:visible />

      <!-- Info -->
      <div class="mt-6 text-xs text-[var(--color-text-muted)]">
        <p>
          Runs entirely in your browser. The preview is sandboxed — no network requests leak out. Load any .html file or paste directly.
        </p>
      </div>
    </div>
  </main>

  <Footer />
  </LabToolLayout>
</BaseLayout>
